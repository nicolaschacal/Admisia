# ─────────────────────────────────────────────────────────────
# Obligatorias para arrancar
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://admisia:CAMBIAR_PASSWORD@127.0.0.1:5432/admisia
DB_SSL=false
CRM_JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO
# Cifra las claves que se cargan desde el panel. Si falta, se usa CRM_JWT_SECRET.
SETTINGS_ENCRYPTION_KEY=
CRON_SECRET=CAMBIAR_POR_OTRO_SECRETO_LARGO
APP_TIMEZONE=America/Montevideo

# ─────────────────────────────────────────────────────────────
# Opcionales: todo lo de abajo también se configura desde
# Panel → Configuración → Integraciones. Lo que cargues en el
# panel tiene prioridad sobre estas variables.
# ─────────────────────────────────────────────────────────────

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=

# Correo saliente
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMISSIONS_EMAIL=

# Google Calendar
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Primer administrador por línea de comandos (alternativa al asistente web)
CRM_ADMIN_EMAIL=
CRM_ADMIN_PASSWORD=
CRM_ADMIN_NAME=

FOLLOWUP_DELAY_DAYS=2
