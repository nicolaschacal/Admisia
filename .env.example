# Gemini
GEMINI_API_KEY=

# PostgreSQL privado
DATABASE_URL=postgresql://admisia:CAMBIAR_PASSWORD@127.0.0.1:5432/admisia
DB_SSL=false

# Autenticación del CRM
CRM_JWT_SECRET=CAMBIAR_POR_UN_SECRETO_LARGO
CRM_ADMIN_EMAIL=admisiones@nubarian.edu.uy
CRM_ADMIN_PASSWORD=
CRM_ADMIN_NAME=Administrador Nubarian

# Correo saliente (SMTP del colegio o proveedor autorizado)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Colegio Nubarian <admisiones@nubarian.edu.uy>"
