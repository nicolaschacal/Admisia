# Recordatorios / tareas programadas
CRON_SECRET=CAMBIAR_POR_OTRO_SECRETO_LARGO
FOLLOWUP_DELAY_DAYS=2

# Zona horaria institucional
APP_TIMEZONE=America/Montevideo

# Google Calendar opcional
GOOGLE_CALENDAR_ID=
